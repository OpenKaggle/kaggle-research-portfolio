{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.arc2.paper/schemas/competition_observation_v1.schema.json",
  "title": "ARC-AGI-2 competition terminal observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_mode",
    "kernel_slug",
    "notebook_version",
    "authoritative_kernel_status",
    "raw_kernel_status",
    "status_verified_at_cst",
    "artifacts_downloaded",
    "submission_id",
    "submission_status",
    "leaderboard_score",
    "score_scope",
    "score_observed_at",
    "started_at_cst",
    "completed_at_cst",
    "wall_seconds",
    "peak_memory_mb",
    "failed_task_ids",
    "timed_out_task_ids",
    "notebook_sha256",
    "submission_sha256",
    "input_manifest_sha256",
    "run_log_sha256",
    "kernel_metadata_sha256",
    "public_leaderboard_used_for_selection",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "observation_mode": {"const": "READ_ONLY_KAGGLE_SUBMISSION_RECEIPT"},
    "kernel_slug": {"type": "string", "minLength": 1},
    "notebook_version": {"type": "integer", "minimum": 1},
    "authoritative_kernel_status": {"const": "COMPLETE"},
    "raw_kernel_status": {"type": "string", "minLength": 1},
    "status_verified_at_cst": {"$ref": "#/$defs/timestamp"},
    "artifacts_downloaded": {"const": true},
    "submission_id": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "integer", "minimum": 0}
      ]
    },
    "submission_status": {"const": "complete"},
    "leaderboard_score": {"type": "number", "minimum": 0, "maximum": 1},
    "score_scope": {
      "enum": ["public_leaderboard", "private_leaderboard", "final"]
    },
    "score_observed_at": {"$ref": "#/$defs/timestamp"},
    "started_at_cst": {"$ref": "#/$defs/timestamp"},
    "completed_at_cst": {"$ref": "#/$defs/timestamp"},
    "wall_seconds": {"type": "number", "exclusiveMinimum": 0},
    "peak_memory_mb": {"type": "number", "exclusiveMinimum": 0},
    "failed_task_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/taskId"}
    },
    "timed_out_task_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/taskId"}
    },
    "notebook_sha256": {"$ref": "#/$defs/sha256"},
    "submission_sha256": {"$ref": "#/$defs/sha256"},
    "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "run_log_sha256": {"$ref": "#/$defs/sha256"},
    "kernel_metadata_sha256": {"$ref": "#/$defs/sha256"},
    "public_leaderboard_used_for_selection": {"const": false},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "taskId": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
